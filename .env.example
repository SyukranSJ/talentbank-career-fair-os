# ---------------------------------------------------------------------------
# Talentbank Career Fair OS — environment variables
# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file,
# which contains NAMES ONLY and never values, is the one that gets committed.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Supabase dashboard -> Project Settings -> Data API / API Keys

# Safe to expose to the browser. Protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses Row Level Security completely.
# Used ONLY by `npm run seed` (a local script). It is never imported by any
# file under src/app, and it has no NEXT_PUBLIC_ prefix, so Next.js will not
# bundle it into client JavaScript.
SUPABASE_SERVICE_ROLE_KEY=


# --- AI Event Copilot (Google Gemini) -------------------------------------
# SECRET. Server-side only — the Copilot runs inside a Next.js server action,
# so this key never reaches the browser.
# Create a free key at https://aistudio.google.com/apikey
# The Gemini free tier covers this project; no billing account is required.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite, chosen by measuring free-tier
# latency AND daily quota for this workload:
#
#   gemini-3.5-flash-lite   ~3.4s   high daily quota      <- default
#   gemini-3.5-flash        ~4.0s   only 20 requests/DAY
#   gemini-3.6-flash        ~12s
#   gemini-3.7-flash        503 "high demand" after 80-105s
#   gemini-2.5-flash        404 - withdrawn for new API keys
#
# Quotas are per model per day, so if one runs dry, switching here is the
# fastest fix. The free tier also limits requests per minute, so space demo
# questions a few seconds apart.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Thinking depth: LOW (default), MEDIUM, HIGH, or OFF to omit it.
# LOW keeps the Copilot responsive while still reasoning about clashes.
# GEMINI_THINKING_LEVEL=LOW

# --- Seed script only -----------------------------------------------------
# `npm run seed` creates this admin account so you can sign in at /admin.
SEED_ADMIN_EMAIL=events@talentbank.demo
SEED_ADMIN_PASSWORD=
